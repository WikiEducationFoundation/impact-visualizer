.TopicDetail {
}

.TopicDetail-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.TopicDetailIntro {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  border-bottom: 1px solid $borderGrey;
  padding-bottom: 2rem;
}

.TopicDetailIntro-main {
  background: white;
  border-radius: 4px;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
  padding: 20px 24px;
  align-self: flex-start;
}

.TopicDetailIntro-description :last-child {
  margin-bottom: 0;
}

.TopicDetail-noStats {
  background: white;
  text-align: center;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
  padding: 1rem;
  font-size: 1.25rem;
  color: $mediumLightGrey;
}

.TopicDetail-bubbleSection {
  padding: 0 1.5rem 2rem;
}

.TopicProgress {
  min-width: 320px;
  max-width: 420px;
  background: white;
  box-shadow: 0 1px 6px rgba(0, 0, 0, 0.1);
  padding: 1rem 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 0.85rem;
  margin-left: 3rem;
}

.TopicProgress-header {
  display: flex;
  align-items: baseline;
  gap: 0.6rem;
  position: relative;
}

.TopicProgress-title {
  margin: 0;
  flex: 1;
}

.TopicProgress-updatedAt {
  color: $blue;
  font-weight: 400;
  white-space: nowrap;
}

.TopicProgress-eta {
  font-size: 0.75rem;
  color: $mediumGrey;
}

/* ----- Skeleton bar chart that previews the eventual deliverable ----- */

.ProgressChart {
  width: 100%;
  height: 70px;
  display: block;
}

.ProgressChart-baseline {
  stroke: $lightGrey;
  stroke-width: 1;
}

.ProgressChart-bar {
  /* Smoothly lift each bar from y=58 (zero) to its target height as
     overall progress crosses its slot. Both y and height transition. */
  transition:
    y 700ms cubic-bezier(0.22, 1, 0.36, 1),
    height 700ms cubic-bezier(0.22, 1, 0.36, 1),
    fill 350ms ease;
  fill: $blue;
}

$phaseImport: #6f8cd6;
$phaseAnalytics: #a06ec8;
$phaseTimeline: #4caf85;

@each $phase, $color in (0, 1, 2),
  ($phaseImport, $phaseAnalytics, $phaseTimeline) {
  $ink: color($color shade(25%));

  .ProgressChart-bar--phase-$(phase) {
    fill: $color;
  }

  .ProgressLegend-item--phase-$(phase).ProgressLegend-item--running,
  .ProgressLegend-item--phase-$(phase).ProgressLegend-item--complete {
    color: $ink;
  }

  .ProgressLegend-item--phase-$(phase) .ProgressLegend-check {
    background: $ink;
  }
}

.ProgressChart-bar--pending {
  fill: $lightGrey;
}

.ProgressChart-bar--active {
  /* The single bar currently being drawn pulses to convey activity. */
  animation: ProgressChartBarPulse 1.4s ease-in-out infinite;
  transform-origin: center bottom;
}

@keyframes ProgressChartBarPulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

/* ----- Phase legend (3-column status row beneath the chart) ----- */

.ProgressLegend {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0.4rem;
  font-size: 0.78rem;
  color: $mediumLightGrey;
}

.ProgressLegend-item {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ProgressLegend-item--running {
  font-weight: 600;
}

.ProgressLegend-marker {
  width: 14px;
  height: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ProgressLegend-check {
  color: white;
  border-radius: 50%;
  width: 14px;
  height: 14px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 9px;
  font-weight: 700;
}

.ProgressLegend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: currentColor;
  animation: ProgressLegendPulse 1.4s ease-out infinite;
}

@keyframes ProgressLegendPulse {
  0% {
    box-shadow: 0 0 0 0 currentColor;
  }
  70% {
    box-shadow: 0 0 0 8px transparent;
  }
  100% {
    box-shadow: 0 0 0 0 transparent;
  }
}

.ProgressLegend-dotPending {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: $lightGrey;
}

/* ----- Detail / sub-stages text ----- */

.TopicProgress-detail {
  font-size: 0.78rem;
  color: $mediumGrey;
  font-style: italic;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-top: -0.15rem;
}

.TopicProgress-subStages {
  display: flex;
  flex-wrap: wrap;
  gap: 0.35rem 0.6rem;
  font-size: 0.7rem;
  color: $mediumLightGrey;
}

.TopicProgress-subStage--complete {
  color: color($phaseTimeline shade(25%));
}

.TopicProgress-subStage--current {
  color: $mediumGrey;
  font-weight: 600;
}

.TopicProgress-chartNote {
  font-size: 0.72rem;
  line-height: 1.4;
  color: $mediumLightGrey;
  margin-top: -0.35rem;
}

.TopicProgress-startButton {
  align-self: flex-start;
}

.TopicProgress-finePrint {
  font-size: 0.75rem;
  color: $mediumLightGrey;
}

.TopicOverflow {
  position: relative;
  margin-left: auto;
}

.TopicOverflow-trigger {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 1.2rem;
  line-height: 1;
  padding: 0.1rem 0.5rem;
  cursor: pointer;
  color: $mediumGrey;

  &:hover {
    background: $lightGrey;
  }
}

.TopicOverflow-menu {
  position: absolute;
  right: 0;
  top: 100%;
  margin-top: 0.25rem;
  background: white;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  border-radius: 4px;
  min-width: 200px;
  z-index: 10;
  display: flex;
  flex-direction: column;
  padding: 0.25rem 0;
}

.TopicOverflow-item {
  background: transparent;
  border: 0;
  text-align: left;
  padding: 0.5rem 0.75rem;
  font-size: 0.85rem;
  cursor: pointer;
  color: $mediumGrey;
  text-decoration: none;
  display: block;

  &:hover {
    background: $lightGrey;
  }

  &:disabled {
    color: $mediumLightGrey;
    cursor: not-allowed;
  }
}
