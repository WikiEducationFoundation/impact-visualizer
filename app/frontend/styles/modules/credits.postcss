.Credits-title {
  @mixin h1;
  margin-bottom: 12px;
}

.Credits-intro {
  max-width: 760px;
  font-size: 17px;
  line-height: 1.55;
  color: $mediumGrey;
  margin: 0 0 40px;
}

.Credits-list {
  max-width: 760px;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr;
  border-top: 1px solid $borderGrey;

  @mixin above $medium {
    grid-template-columns: 200px 1fr;
  }
}

.Credits-role {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: $blue;
  padding-top: 24px;

  @mixin above $medium {
    padding-right: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid $borderGrey;
  }
}

.Credits-names {
  font-size: 17px;
  line-height: 1.6;
  color: $grey;
  margin: 0;
  padding-top: 8px;
  padding-bottom: 24px;
  border-bottom: 1px solid $borderGrey;

  @mixin above $medium {
    padding-top: 24px;
  }
}
